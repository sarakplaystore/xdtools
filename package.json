{
  "name": "xdtools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "xdtools — free browser tools. Includes a PDF editor with full Khmer support and automatic font matching.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build && node scripts/offline-manifest.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "harfbuzzjs": "1.6.4",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.5.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
